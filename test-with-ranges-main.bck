void read_stored_values() {
    current_function = get_int(FUNC, (int)FUNC_UNKOWN);
    current_rate = get_int(RATE, (int)RATE_FAST);
    /*current_auto = get_int(AUTO, 0);
    current_vdc_range = get_int(RANGE"VDC", 0);
    current_vac_range = get_int(RANGE"VAC", 0);
    current_adc_range = get_int(RANGE"ADC", 0);
    current_aac_range = get_int(RANGE"AAC", 0);*/
}

void poll_task( void * pvParameters ) {
    while(true) {
        query_owon(RATE);
        //query_owon(AUTO);
        query_owon(FUNC);
        //query_owon(RANGE);
    }
}

void app_main() {
    nvs_flash_init();    
    vTaskDelay(pdMS_TO_TICKS(5000));
    read_stored_values();
    init_serial();
    vTaskDelay(pdMS_TO_TICKS(200));
    write_saved_settings();
    xTaskCreate(poll_task, "poll_task", 4096, NULL, tskIDLE_PRIORITY + 1, &poll_task_handle);
}